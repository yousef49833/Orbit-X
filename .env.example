# GEMINI_API_KEY: Required for the Orbit-X Flight Director telemetry integration.
# Configure this value in the deployment environment or local .env file.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where the Orbit-X mission lab is hosted.
# Used for self-referential links and API endpoints.
APP_URL="MY_APP_URL"
